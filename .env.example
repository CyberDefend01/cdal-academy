# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API Keys.
# On Vercel, add the same variables under Project -> Settings -> Environment Variables.

# Public (safe to expose to the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET - server only. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
# Used only in admin-checked server actions (creating student accounts, password-change flag).
SUPABASE_SECRET_KEY=sb_secret_xxx
